  {
    "id": "lsass-access",
    "title": "Unusual LSASS process access",
    "technique": "T1003.001",
    "technique_name": "LSASS Memory",
    "tactic": "credential-access",
    "scenario": "credential-access",
    "category": "process",
    "severity": "high",
    "positive": {
      "event.code": "10",
      "event.provider": "Microsoft-Windows-Sysmon",
      "process.executable": "C:\\Lab\\diagnostic.exe",
      "winlog.event_data.TargetImage": "C:\\Windows\\System32\\lsass.exe",
      "winlog.event_data.GrantedAccess": "0x1fffff"
    },
    "negative": {
      "event.code": "10",
      "event.provider": "Microsoft-Windows-Sysmon",
      "process.executable": "C:\\Lab\\diagnostic.exe",
      "winlog.event_data.TargetImage": "C:\\Windows\\System32\\lsass.exe",
      "winlog.event_data.GrantedAccess": "0x1000"
    },
    "selection": {
      "EventID": 10,
      "TargetImage|endswith": "\\lsass.exe",
      "GrantedAccess": [
        "0x1fffff",
        "0x1f0fff"
      ]
    },
    "false_positive": "EDR and approved diagnostic tools may access LSASS; corroborate signature, owner and access mask.",
    "rationale": "High access masks against LSASS can indicate credential access. This does not prove a dump occurred.",
    "uuid": "386c5daa-b277-5844-a68d-60c199980ce4",
    "query": "event.provider: \"Microsoft-Windows-Sysmon\" AND (event.code: \"10\") AND (winlog.event_data.TargetImage: *\\\\lsass.exe) AND (winlog.event_data.GrantedAccess: \"0x1fffff\" OR winlog.event_data.GrantedAccess: \"0x1f0fff\")",
    "native_filters": [
      {
        "term": {
          "event.code": "10"
        }
      },
      {
        "wildcard": {
          "winlog.event_data.TargetImage": {
            "value": "*\\\\lsass.exe",
            "case_insensitive": true
          }
        }
      },
      {
        "bool": {
          "should": [
            {
              "term": {
                "winlog.event_data.GrantedAccess": "0x1fffff"
              }
            },
            {
              "term": {
                "winlog.event_data.GrantedAccess": "0x1f0fff"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    ]
  },
