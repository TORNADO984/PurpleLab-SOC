[
  {
    "id": "encoded-powershell",
    "title": "PowerShell encoded command",
    "technique": "T1059.001",
    "technique_name": "PowerShell",
    "tactic": "execution",
    "scenario": "execution",
    "category": "process",
    "severity": "medium",
    "positive": {
      "event.code": "1",
      "event.provider": "Microsoft-Windows-Sysmon",
      "process.executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "process.command_line": "powershell.exe -NoProfile -EncodedCommand VwByAGkAdABlAC0ATwB1AHQAcAB1AHQAIABsAGEAYgA="
    },
    "negative": {
      "event.code": "1",
      "event.provider": "Microsoft-Windows-Sysmon",
      "process.executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "process.command_line": "powershell.exe -NoProfile -Command Get-Date"
    },
    "selection": {
      "EventID": 1,
      "Image|endswith": "\\powershell.exe",
      "CommandLine|contains": "-EncodedCommand"
    },
    "false_positive": "Management agents may encode trusted scripts; validate the decoded content and approved deployment.",
    "rationale": "Encoded script execution can conceal intent; encoding alone is not proof of maliciousness.",
    "uuid": "a8c94457-cf0a-591b-ab17-f7cfc534ef43",
    "query": "event.provider: \"Microsoft-Windows-Sysmon\" AND (event.code: \"1\") AND (process.executable: *\\\\powershell.exe) AND (process.command_line: *-EncodedCommand*)",
    "native_filters": [
      {
        "term": {
          "event.code": "1"
        }
      },
      {
        "wildcard": {
          "process.executable": {
            "value": "*\\\\powershell.exe",
            "case_insensitive": true
          }
        }
      },
      {
        "wildcard": {
          "process.command_line": {
            "value": "*-EncodedCommand*",
            "case_insensitive": true
          }
        }
      }
    ]
  },
